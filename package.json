{
  "name": "appathenea",
  "version": "0.1.0",
  "private": true,
  "description": "Local desktop shell for AppAthenea Mars mission planning demo",
  "main": "desktop/main.cjs",
  "scripts": {
    "prepare:desktop": "node scripts/prepare-desktop-assets.cjs",
    "build:web": "node scripts/build-web.cjs",
    "start": "npm run prepare:desktop && electron .",
    "package:win": "npm run prepare:desktop && electron-builder --win nsis"
  },
  "dependencies": {
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "org.appathenea.desktop",
    "productName": "AppAthenea",
    "asar": true,
    "files": [
      "index.html",
      "mission.html",
      "*.js",
      "data/**/*",
      "desktop/**/*",
      "scripts/**/*",
      "vendor/**/*",
      "package.json",
      "!video/**/*",
      "!node_modules/**/*"
    ],
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
